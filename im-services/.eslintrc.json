{
    "env": {
        "browser": true,
        "es6": true,
        "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2017,
        "sourceType": "module"
    },
    "rules": {
        "indent": [
            "error",
            4
        ],
        "linebreak-style": [
            "error",
            "unix"
        ],
        "quotes": [
            "error",
            "double",
            { "allowTemplateLiterals": true }
        ],
        "semi": ["error", "always"],
        "no-console":"off",
        "no-unused-vars":"warn",
        "space-before-blocks": ["error"],
        "keyword-spacing": "warn",
        "no-constant-condition": ["error", { "checkLoops": false }]
    },
    "globals": {
        "pool": false,
        "db_pool": false,
        "config": false,
        "settings": false
    }
}